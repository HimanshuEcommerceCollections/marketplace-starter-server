// Prisma schema for the Elevate service booking platform.
// Docs: https://pris.ly/d/prisma-schema
//
// Conventions:
//   - Money is stored in INTEGER MINOR units (e.g. cents) to avoid float drift.
//   - All ids are UUID strings. All tables carry createdAt / updatedAt.
//   - Enums live here as the single source of truth and are re-exported to the
//     app via src/enums (which imports them from @prisma/client).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime connection. On serverless this is Supabase's TRANSACTION pooler
  // (port 6543, `pgbouncer=true`): every function instance opens its own pool,
  // so the session pooler's one-Postgres-connection-per-client model runs the
  // database out of connections under concurrency. `pgbouncer=true` is required
  // there — transaction mode cannot hold the named prepared statements Prisma
  // would otherwise use.
  url       = env("DATABASE_URL")
  // Migrations + introspection need a single un-pooled session, which the
  // transaction pooler cannot give them. Point this at port 5432.
  directUrl = env("DIRECT_URL")
}

// ────────────────────────────────────────────────────────────────────────────
// Enums
// ────────────────────────────────────────────────────────────────────────────

enum UserRole {
  USER_CUSTOMER
  SYSTEM_PROVIDER
  SYSTEM_COORDINATOR
  SYSTEM_ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  // Admin/coordinator-provisioned account that has been emailed an invite but has
  // not yet set a password. Cannot sign in until the invite is accepted.
  INVITED
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Brand {
  ELEVATE
  APEX
  EVENTS
  EDUCATION
}

/// Service coverage areas (Wake County towns). A user may cover/select several,
/// so `User.area` is a LIST of these values — never a single choice.
enum ServiceArea {
  RALEIGH
  CARY
  APEX
  WAKE_FOREST
  MORRISVILLE
  GARNER
  HOLLY_SPRINGS
  FUQUAY_VARINA
  KNIGHTDALE
  WENDELL
  ZEBULON
  ROLESVILLE
}

enum BookingStatus {
  DRAFT
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum WaitlistStatus {
  ACTIVE
  NOTIFIED
  CONVERTED
  CANCELLED
  EXPIRED
}

enum LocationMode {
  ONSITE
  REMOTE
  HYBRID
}

enum ServiceStatus {
  DRAFT
  ACTIVE
  COMING_SOON
  INACTIVE
}

enum ConfigSelectionType {
  SINGLE_SELECT // user must choose exactly one option
  MULTI_SELECT // user may choose zero or more options
}

enum ConfigStatus {
  ACTIVE
  INACTIVE
}

/// Lifecycle for admin-managed geography (Area, ZipCode).
///   ACTIVE   — live and bookable.
///   INACTIVE — temporarily paused. Still visible and editable in admin.
///   ARCHIVED — retired / created by mistake. Hidden from admin lists unless
///              ?status=ARCHIVED. NOT deletable, and it KEEPS its unique
///              name/slug/zipCode slot — restore it, don't recreate it.
/// There is deliberately no `deletedAt` column: this repo has zero soft-delete
/// precedent, and soft delete + unique keys requires a partial unique index that
/// Prisma cannot express (and which `prisma db push` would silently drop).
enum GeoStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

/// A coverage rule's verdict. Rules are evaluated MOST-SPECIFIC-FIRST (the ZIP
/// tier beats the AREA tier) and the first NON-NULL effect wins outright.
/// No effect at any tier = DENY. See coverage.service.ts resolve().
enum CoverageEffect {
  ALLOW
  DENY
}

/// Which tier actually authorised a booking. Stamped on Booking so reporting can
/// tell "a ZIP proved the area" apart from "the customer picked the area and the
/// ZIP was unrecognised". Without this, revenue-by-area silently blends the two.
enum CoverageSource {
  ZIP_RULE // an explicit ServiceZipCoverage ALLOW
  AREA_RULE // inherited from ServiceAreaCoverage ALLOW
  AREA_FALLBACK // ZIP unknown; allowed against the caller-supplied areaId
  NOT_APPLICABLE // REMOTE booking — coverage does not apply
}

enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  WAITLIST_AVAILABLE
  REVIEW_REQUEST
  GENERIC
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum CorporateInquiryStatus {
  NEW // just submitted, awaiting triage
  CONTACTED // a coordinator has reached out
  QUALIFIED // qualified lead, proposal in progress
  CLOSED // resolved (won, lost, or archived)
}

enum ProfessionalApplicationStatus {
  NEW // just submitted, awaiting triage
  REVIEWING // a coordinator is vetting the applicant
  ACCEPTED // approved — an INVITED provider account has been created
  REJECTED // declined or archived (no account, no email sent)
}

/// Why a VerificationToken was issued. EMAIL_VERIFICATION tokens redeem at
/// /verify-email; INVITE tokens redeem at /accept-invite and additionally set the
/// account's first password. Kept distinct so a signup link can never be replayed
/// to take over an invited staff/provider account.
enum VerificationPurpose {
  EMAIL_VERIFICATION
  INVITE
}

// ────────────────────────────────────────────────────────────────────────────
// Identity & access
// ────────────────────────────────────────────────────────────────────────────

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  passwordHash    String
  name            String
  phone           String?
  brand           Brand
  // Coverage areas the user selected at signup. A LIST (multi-select) — empty by
  // default; existing rows are backfilled to [RALEIGH] in the add-user-area migration.
  area            ServiceArea[] @default([])
  role            UserRole   @default(USER_CUSTOMER)
  status          UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  providerProfile    ServiceProvider?
  bookingsAsCustomer Booking[]        @relation("CustomerBookings")
  reviews            Review[]
  refreshTokens      RefreshToken[]
  verificationTokens VerificationToken[]
  waitlistEntries    WaitlistEntry[]
  notifications      Notification[]
  userDetails        UserDetails[]

  @@index([role])
  @@index([status])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Single-use email-verification tokens. Like RefreshToken, only the SHA-256 hash
/// of the emailed token is persisted — the plaintext lives solely in the emailed
/// verification link. A row is consumed (`consumedAt` stamped) on redeem, and any
/// outstanding rows for a user are deleted when a new token is requested (resend),
/// so at most one live token exists per user at a time.
model VerificationToken {
  id         String              @id @default(uuid())
  userId     String
  tokenHash  String              @unique
  purpose    VerificationPurpose @default(EMAIL_VERIFICATION)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, purpose])
}

/// Profile for users who deliver services (role SYSTEM_PROVIDER or SYSTEM_COORDINATOR).
model ServiceProvider {
  id         String   @id @default(uuid())
  userId     String   @unique
  displayName String
  bio        String?
  credential String? // professional credential shown on bookings (e.g. "LMBT", "DPT", "RYT-500")
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  services          Service[]
  availabilitySlots AvailabilitySlot[]
  bookings          Booking[]          @relation("ProviderBookings")
}

// ────────────────────────────────────────────────────────────────────────────
// Catalog
// ────────────────────────────────────────────────────────────────────────────

model Service {
  id              String        @id @default(uuid())
  name            String        @unique
  slug            String        @unique
  description     String?
  providerId      String?
  priceAmount     Int // BASE for booking math (= pricing base_price.amount), minor units
  currency        String        @default("USD")
  durationMinutes Int           @default(60)
  locationMode    LocationMode  @default(ONSITE) // default/primary mode
  status          ServiceStatus @default(DRAFT)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Catalog parity (client services.json). All nullable/defaulted for safe migration.
  pricingRef    String? // client `pricing_ref`; the pricing.v1.json key (id-alignment resolution)
  summary       String? // short marketing blurb (distinct from long `description`)
  serviceType   String? // free-form classifier (client `service_type`)
  fromPrice     Int? // client `from_price`; DISPLAY-ONLY "From $X" band, NOT the booking base
  minBooking    Int? // client `min_booking`; hard booking floor (e.g. beauty = 7500)
  badges        String[]       @default([]) // client `badges`
  locationModes LocationMode[] @default([]) // full set offered (booking picks one)

  /// Bumped on EVERY coverage write, inside the same transaction. The coverage
  /// editor echoes the version it read; a mismatch is a loud 409 instead of a
  /// silent lost update. Two coordinators editing different areas of the same
  /// service is the normal case, and without this the second write reverts the
  /// first — invisibly, because coverage is only observable by resolving a ZIP.
  coverageVersion Int @default(0)

  provider          ServiceProvider?     @relation(fields: [providerId], references: [id])
  bookings          Booking[]
  reviews           Review[]
  availabilitySlots AvailabilitySlot[]
  waitlistEntries   WaitlistEntry[]
  configGroups      ServiceConfigGroup[]
  areaCoverage      ServiceAreaCoverage[]
  zipCoverage       ServiceZipCoverage[]

  @@index([providerId])
  @@index([status])
}

/// A configurable dimension of a service (Duration, Session Type, Add-Ons…).
/// `key` equals the pricing modifier id within services[service.pricingRef]
/// (id-alignment contract) — carried verbatim from source, never slugged from the label.
/// A group may only be ACTIVE if it has >= 1 option (enforced at activation).
model ServiceConfigGroup {
  id            String              @id @default(uuid())
  serviceId     String
  key           String // == pricing modifier id under service.pricingRef
  label         String
  selectionType ConfigSelectionType
  isRequired    Boolean             @default(false)
  sortOrder     Int                 @default(0)
  status        ConfigStatus        @default(INACTIVE) // ACTIVE requires >= 1 option
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  service Service               @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  options ServiceConfigOption[]

  @@unique([serviceId, key])
  @@index([serviceId, sortOrder])
}

/// A choice within a group (60 min, Hot Stones…). `key` equals the pricing modifier
/// option id within services[service.pricingRef]. `priceModifier` is added to the
/// service base price when selected (minor units; >= 0 surcharge).
model ServiceConfigOption {
  id            String       @id @default(uuid())
  groupId       String
  key           String // == pricing modifier option id under service.pricingRef
  label         String
  priceModifier Int          @default(0) // surcharge in minor units (cents); 0 = no change
  description   String?
  sortOrder     Int          @default(0)
  status        ConfigStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  group ServiceConfigGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, key])
  @@index([groupId, sortOrder])
}

// ────────────────────────────────────────────────────────────────────────────
// Geography & coverage
// ────────────────────────────────────────────────────────────────────────────

/// An admin-managed OPERATING MARKET — the unit the business staffs, prices and
/// dispatches from. Replaces the ServiceArea enum 1:1.
///
/// An Area is NOT a legal boundary and is NEVER itself bookable: it supplies the
/// DEFAULT coverage verdict for the ZIPs beneath it. Only a ZipCode is bookable.
/// "We serve 27502 out of the Apex market" is a business decision (single-valued,
/// reversible with one UPDATE); "27502 is in Apex" is a geographic claim that is
/// only partly true and which this model deliberately does not make.
///
/// INVARIANT: geography is exactly TWO levels — Area -> ZipCode. There is no
/// `parentId` and no `type`. Everything on the roadmap (states, counties, cities,
/// neighborhoods, zones) is a LABEL on one of these two rows or a GROUPING beside
/// them — never a third level of availability resolution.
model Area {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique // lowercase kebab, from src/utils/slugify.ts
  stateCode   String    @default("NC") // USPS 2-letter, uppercase
  countryCode String    @default("US") // ISO-3166-1 alpha-2
  timezone    String    @default("America/New_York") // IANA; operating-hours-by-area needs it
  status      GeoStatus @default(ACTIVE)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  zipCodes        ZipCode[]
  serviceCoverage ServiceAreaCoverage[]
  bookings        Booking[]

  @@index([status, sortOrder])
}

/// A 5-digit USPS ZIP owned by exactly ONE Area. `zipCode` is GLOBALLY unique
/// because booking validation resolves an Area FROM a customer-typed ZIP, and
/// that is only deterministic with a single owner.
///
/// `zipCode` is TEXT, never Int: "07001" must not become 7001. Canonical form is
/// exactly 5 ASCII digits; ZIP+4 is truncated at the zod boundary and backstopped
/// by the ZipCode_zipCode_us_format_check CHECK constraint.
model ZipCode {
  id          String    @id @default(uuid())
  areaId      String
  zipCode     String    @unique
  city        String? // USPS preferred city. DISPLAY ONLY — never resolves an Area.
  stateCode   String    @default("NC")
  countryCode String    @default("US")
  status      GeoStatus @default(ACTIVE)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Restrict, not Cascade: an Area with ZIPs must not be deletable. Retirement is
  // status = ARCHIVED, which is also the only path Booking's Restrict FK permits.
  area            Area                 @relation(fields: [areaId], references: [id], onDelete: Restrict)
  serviceCoverage ServiceZipCoverage[]
  bookings        Booking[]

  // Target of the COMPOSITE foreign key on ServiceZipCoverage. This is what pins
  // a zip-level coverage rule to the area it was authored under, so a ZIP cannot
  // be moved out from under a rule. Not a business constraint — a
  // referential-integrity anchor.
  @@unique([id, areaId])
  @@index([areaId, status])

  // Prefix search. Under the en_US.UTF-8 collation Supabase defaults to, a plain
  // btree CANNOT serve LIKE 'x%', so text_pattern_ops is declared explicitly.
  // These are the difference between an index scan and a seq scan on every
  // debounced keystroke in the admin ZIP search and coverage picker.
  @@index([zipCode(ops: raw("text_pattern_ops"))])
  @@index([areaId, zipCode(ops: raw("text_pattern_ops"))])
  @@index([city(ops: raw("text_pattern_ops"))])
}

/// Service <-> Area coverage rule — the DEFAULT tier.
///   effect = ALLOW  -> every ACTIVE ZIP in this area is covered UNLESS that ZIP
///                      carries its own rule for this service.
///   effect = DENY   -> the area is NOT covered area-wide; only ZIPs carrying an
///                      explicit ALLOW are covered.
///   effect = NULL   -> this row carries NO coverage verdict. Reserved for rows
///                      that exist only to hang future per-area payload
///                      (priceAdjustmentAmount, serviceFeeAmount) off. NULL is
///                      TRANSPARENT to resolution: COALESCE skips it. A CHECK
///                      constraint forbids NULL today; widening it when a payload
///                      column lands is a one-line migration.
///
/// Absence of a row entirely = the service was never configured for this area.
/// Resolution treats that identically to DENY but reports NOT_CONFIGURED, which
/// is a different customer experience (waitlist) and a different admin report.
///
/// CANONICAL FORM RULE: any area a service touches at ALL must have a row here.
/// Writing a ServiceZipCoverage row for a (service, area) pair with no
/// ServiceAreaCoverage row is rejected by the service layer.
model ServiceAreaCoverage {
  id        String          @id @default(uuid())
  serviceId String
  areaId    String
  effect    CoverageEffect?

  /// When a NEW ZipCode is later added to this area, does this service inherit
  /// coverage automatically?
  ///   true  (default) -> yes. A ZIP inserted next month is covered with zero writes.
  ///   false           -> no. Set AUTOMATICALLY the moment a DENY zip rule is
  ///                      written for this (service, area) pair. An exclusion is
  ///                      direct evidence the area is not uniformly serviceable,
  ///                      so a bulk paste of ZIPs must not silently expand into it.
  /// Enforced at ZIP-CREATE time, NOT at resolve time: the resolver stays a clean
  /// two-tier COALESCE with no third bit.
  autoIncludeNewZips Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  area    Area    @relation(fields: [areaId], references: [id], onDelete: Restrict)

  @@unique([serviceId, areaId]) // makes contradictory area rules UNSTORABLE
  @@index([areaId]) // reverse: "which services cover this area?"
}

/// Service <-> ZipCode coverage rule — the MOST SPECIFIC tier. Overrides the area
/// rule for this ZIP only. Absence of a row = inherit the area rule.
///   effect = ALLOW -> opt this ZIP in (zip-only availability, one-off ZIPs).
///   effect = DENY  -> carve this ZIP out of an otherwise area-wide grant.
///   effect = NULL  -> payload-only row, transparent to resolution.
model ServiceZipCoverage {
  id        String @id @default(uuid())
  serviceId String
  zipCodeId String

  /// Denormalized copy of ZipCode.areaId. NOT independently editable — it is half
  /// of the composite FK below, which pins this rule to the ZIP's area. Without
  /// it, moving a ZIP between areas silently grants coverage in a market it was
  /// never granted, and drags an exclusion into it as an unauthored hole. With it,
  /// the move is REFUSED by Postgres until an admin resolves the rules explicitly.
  areaId String

  effect    CoverageEffect?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  // COMPOSITE FK. onUpdate: Restrict is the whole point — do NOT use Cascade,
  // which would silently repoint the rule to the new area (that IS the bug).
  zipCode ZipCode @relation(fields: [zipCodeId, areaId], references: [id, areaId], onDelete: Cascade, onUpdate: Restrict)

  @@unique([serviceId, zipCodeId]) // a (service, ZIP) pair is ALLOW xor DENY, never both
  @@index([zipCodeId]) // reverse: "which services override at this ZIP?"
  @@index([serviceId, areaId]) // the coverage editor's per-area rule fetch
}

// ────────────────────────────────────────────────────────────────────────────
// Booking & scheduling
// ────────────────────────────────────────────────────────────────────────────

model Booking {
  id             String        @id @default(uuid())
  reference      String        @unique
  customerId     String
  serviceId      String
  providerId     String?
  status         BookingStatus @default(PENDING)
  scheduledStart DateTime
  scheduledEnd   DateTime
  priceAmount    Int
  currency       String        @default("USD")
  locationMode   LocationMode  @default(ONSITE)
  /// DEPRECATED: the legacy 12-town enum. Kept and DUAL-WRITTEN until the
  /// contract migration drops it, so a rollback to the previous server version
  /// still finds its read path populated. Do not add new readers.
  area           ServiceArea?

  // ── Coverage: FKs for joins, snapshots for history. Both, deliberately. ──
  // FK-only loses history (rename an Area and an old invoice retroactively
  // rewords; re-home a ZIP and last year's revenue moves between markets).
  // Snapshot-only loses joins ("all bookings in this area this quarter" becomes a
  // string match across historical spellings). Carrying both is exactly what
  // priceAmount, selections and the whole user_details table already do.
  //
  // areaId stays NULLABLE IN THE DATABASE FOREVER: historical bookings legitimately
  // hold NULL (area was optional), REMOTE bookings never resolve one, and a
  // DB-level NOT NULL would be an unrollbackable mistake. Enforcement is zod +
  // the service layer.
  areaId           String?
  zipCodeId        String?
  postalCode       String? // normalized 5-digit ZIP, snapshotted
  areaNameSnapshot String? // Area.name as displayed at booking time
  coverageSource   CoverageSource?
  notes          String?
  // Full schedule preferences (all preferred windows + flexibility + timezone)
  // as entered; scheduledStart/End above hold the first preferred window.
  schedulePreferences Json?
  // Immutable snapshot of the chosen config options (PriceLineItem[]) at booking
  // time; priceAmount = service base + sum of these modifiers ("Option A").
  selections     Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  customer    User             @relation("CustomerBookings", fields: [customerId], references: [id])
  service     Service          @relation(fields: [serviceId], references: [id])
  provider    ServiceProvider? @relation("ProviderBookings", fields: [providerId], references: [id])
  payment     Payment?
  review      Review?
  // Immutable snapshot of the customer-entered "Details" step (contact + address).
  userDetails UserDetails?

  // Named coverageArea / coverageZip, NOT area / zipCode: the legacy `area` enum
  // field must survive the backfill and Prisma forbids two fields of one name.
  // These names read correctly permanently, so there is no rename after the drop.
  // Restrict, not the Prisma default SetNull: a booking's geography is history
  // and must never be silently nulled.
  coverageArea Area?    @relation(fields: [areaId], references: [id], onDelete: Restrict)
  coverageZip  ZipCode? @relation(fields: [zipCodeId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([serviceId])
  @@index([providerId])
  @@index([status])
  @@index([scheduledStart])
  @@index([areaId])
  @@index([zipCodeId])
  @@index([postalCode])
}

/// Immutable snapshot of the "Details" step a customer entered for a booking.
/// One row per booking (1:1), tagged with the user it belongs to. Never updated.
model UserDetails {
  id        String   @id @default(uuid())
  bookingId String   @unique
  userId    String
  name       String?
  email      String?
  phone      String?
  address    String?
  postalCode String? // the literal ZIP the customer typed, beside the address they typed
  createdAt  DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("user_details")
}

model AvailabilitySlot {
  id         String   @id @default(uuid())
  serviceId  String?
  providerId String?
  startTime  DateTime
  endTime    DateTime
  isBooked   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  service  Service?         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  provider ServiceProvider? @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([serviceId, startTime])
  @@index([providerId, startTime])
}

model WaitlistEntry {
  id          String         @id @default(uuid())
  serviceId   String
  userId      String
  status      WaitlistStatus @default(ACTIVE)
  desiredDate DateTime?
  notifiedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serviceId, userId])
  @@index([serviceId])
  @@index([status])
}

model Review {
  id          String   @id @default(uuid())
  bookingId   String   @unique
  serviceId   String
  authorId    String
  rating      Int
  comment     String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])

  @@index([serviceId])
  @@index([authorId])
}

// ────────────────────────────────────────────────────────────────────────────
// Forward-looking (payments & notifications) — modelled now so future modules
// plug in without a schema rewrite.
// ────────────────────────────────────────────────────────────────────────────

model Payment {
  id         String        @id @default(uuid())
  bookingId  String        @unique
  amount     Int
  currency   String        @default("USD")
  status     PaymentStatus @default(PENDING)
  provider   String?
  externalId String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Notification {
  id        String             @id @default(uuid())
  userId    String
  type      NotificationType
  status    NotificationStatus @default(PENDING)
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

/// Ledger of processed provider webhook events (Stripe, …). `eventId` is the
/// provider's own event id; its uniqueness makes webhook handling idempotent —
/// a redelivered or concurrent duplicate event is detected and skipped.
model WebhookEvent {
  id          String   @id @default(uuid())
  provider    String // e.g. "stripe"
  eventId     String   @unique // provider event id — idempotency key
  type        String // provider event type, e.g. "payment_intent.succeeded"
  processedAt DateTime @default(now())

  @@index([provider])
}

// ────────────────────────────────────────────────────────────────────────────
// Marketing / lead-gen
// ────────────────────────────────────────────────────────────────────────────

/// A "Request a proposal" submission from the public Corporate Wellness page.
/// Anonymous (no user relation) — captured by anyone; read/triaged by staff in
/// the admin dashboard. `headcount`, `eventType`, and `preferredDate` are kept
/// as free-text strings because they come from open-ended form fields.
/// B2B lead: a company requesting an on-site/hybrid wellness program, submitted
/// from the public /corporate/inquiry page. Purely a sales lead — it never
/// creates an account. Distinct from ProfessionalApplication below, which is a
/// practitioner asking to join the marketplace.
model CorporateInquiry {
  id            String                 @id @default(uuid())
  company       String
  contactName   String
  contactEmail  String
  contactPhone  String?
  headcount     String? // team size (e.g. "50–200")
  eventType     String // requested format (e.g. "On-site series")
  preferredDate String?
  notes         String? // services of interest + free-text message
  status        CorporateInquiryStatus @default(NEW)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([status])
  @@index([createdAt])
}

/// A practitioner's application to join the marketplace, submitted from the form
/// at the foot of the public /pros page. Accepting one provisions an INVITED User
/// + ServiceProvider profile and emails an invite to `contactEmail` — the address
/// the applicant themselves supplied, which is why it is the only contact field
/// that is required and normalized.
model ProfessionalApplication {
  id              String                        @id @default(uuid())
  contactName     String
  contactEmail    String
  contactPhone    String?
  serviceCategory String // primary service they practise (e.g. "Massage Therapy")
  credential      String? // licence/certification shown on bookings (e.g. "LMBT")
  experienceYears Int? // years practising
  serviceArea     String? // free text at intake (e.g. "Raleigh, Wake County")
  website         String?
  notes           String? // free-text "about your practice"
  status          ProfessionalApplicationStatus @default(NEW)
  reviewedAt      DateTime? // when it was accepted or rejected
  reviewedById    String? // staff user who decided (no relation: audit trail must
  // survive that user being deleted)
  invitedUserId   String? @unique // the User created on accept, if any
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt

  @@index([status])
  @@index([createdAt])
}
