# dependencies
node_modules/

# npm config — never commit; script-shell=powershell is a local-Windows-only
# workaround for the "&" in the project path and breaks Linux CI/deploys (Render)
.npmrc

# build output
dist/

# vercel — local project link + pulled env, never commit
.vercel

# env — never commit secrets
.env
.env.*
!.env.example

# logs
*.log
npm-debug.log*

# legacy service-asset registry — still read, never written (no upload API)
data/

# os / editor
.DS_Store
Thumbs.db
.env*
