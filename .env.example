# ──────────────────────────────────────────────────────────────
# Server environment. Copy to `.env` and fill in real values.
# `.env` is gitignored — never commit secrets.
# ──────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=4000

# Cloud Postgres connection string (Neon / Supabase / RDS).
# Hosted Postgres almost always requires SSL — keep `?sslmode=require`.
#   Neon:     postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/DB?sslmode=require
#   Supabase: postgresql://postgres:PASSWORD@db.xxx.supabase.co:5432/postgres
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# JWT — generate strong, unique secrets (min 16 chars; 48+ bytes recommended):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Security
BCRYPT_SALT_ROUNDS=10
CORS_ORIGIN="*"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Stripe payments ───────────────────────────────────────────
# All optional: without STRIPE_SECRET_KEY the app still boots and payment routes
# respond 501; the webhook 501s until STRIPE_WEBHOOK_SECRET is set.
# STRIPE_PUBLISHABLE_KEY is returned to the client so it can init Stripe.js.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# Brand identity stamped on every payment THIS project creates. The Stripe
# account is shared with sibling projects, so PAYMENT_PROJECT_TAG is written to
# metadata.project on each intent — it drives Dashboard filtering
# (search: metadata['project']:'elevate'), namespaces the account-scoped
# idempotency keys, and lets the webhook ignore other projects' events.
# Keep the tag STABLE once live: changing it makes existing payments look
# foreign to the webhook guard.
PAYMENT_PROJECT_TAG="elevate"
PAYMENT_BRAND_NAME="Elevate Health & Wellness"
# Appended to the ACCOUNT-level descriptor prefix on the customer's card
# statement, e.g. prefix "ACME" + this => "ACME* ELEVATE". Set the shared prefix
# in Stripe Dashboard → Settings → Business → Public details. prefix + suffix
# must total <= 22 chars; < > \ " ' * are rejected. Leave blank to omit.
STRIPE_STATEMENT_DESCRIPTOR_SUFFIX="ELEVATE"

# ── Email ────────────────────────────────────────────────────────────────────
# Used for account email-verification and booking notifications.
#
# EMAIL_PROVIDER picks the transport adapter (src/modules/email/providers):
#   gmail  — Gmail / Google Workspace over SMTP (host + port pre-filled)
#   smtp   — any other SMTP server (Mailgun, SES, Postmark, self-hosted)
#   resend — Resend's HTTP API
# Credentials are optional everywhere: without them the app still boots and
# email-dependent flows respond 501 (dev/test), and the boot log says what's
# missing. Switching providers is this one var plus its credentials — no code
# change.
EMAIL_PROVIDER="gmail"

# --- gmail / smtp ---
# GMAIL SETUP: SMTP_USER is the full address; SMTP_PASSWORD must be a 16-char
# App Password, NOT the account password — Google removed "less secure app"
# access. Generate one at https://myaccount.google.com/apppasswords (requires
# 2-Step Verification on the account). Pasting it with the spaces Google shows
# is fine; they're stripped. Gmail sends ~500 messages/day on a free account.
# SMTP_HOST/SMTP_PORT may be left blank for EMAIL_PROVIDER=gmail (defaults to
# smtp.gmail.com:587). For EMAIL_PROVIDER=smtp both are required.
# SMTP_SECURE: leave blank to infer from the port (implicit TLS on 465,
# STARTTLS otherwise); set true/false to force it.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=""
SMTP_USER="you@gmail.com"
SMTP_PASSWORD=""

# --- resend ---
# Only needed when EMAIL_PROVIDER=resend. Get a key at https://resend.com
# (Developers → API Keys).
RESEND_API_KEY=""

# --- sender identity ---
# EMAIL_FROM is an OPTIONAL full override ("Name <addr>" or a bare address).
# Left blank, the sender is derived: SMTP_USER for gmail/smtp, Resend's shared
# onboarding sender (onboarding@resend.dev, delivers only to the Resend account
# owner) for resend — with EMAIL_FROM_NAME as the display name.
# On Gmail, leave EMAIL_FROM blank unless it points at SMTP_USER or one of its
# verified "Send mail as" aliases: Gmail rejects sending as a foreign address.
# On Resend, set it to an address on a domain you verified there.
EMAIL_FROM=""
EMAIL_FROM_NAME="Elevate Health & Wellness"

# APP_URL is the FRONTEND base URL used to build the links in emails (the
# verification link, booking details) — set it to your deployed frontend origin
# (https) in production.
APP_URL="http://localhost:3000"
# Verification-token lifetime in milliseconds (default 24h).
EMAIL_VERIFICATION_TTL_MS=86400000
# Master switch for the email-verification feature (default: true). Set to
# "false" to disable it entirely: new accounts are created active + verified, no
# verification email is sent, and login/booking are NOT gated. Useful while on a
# sandbox sender that only delivers to the account owner.
EMAIL_VERIFICATION_REQUIRED=true
# Master switch for outbound booking notification email (default: true). In-app
# notification rows are always written; "false" only stops them being emailed.
EMAIL_NOTIFICATIONS_ENABLED=true

# ─────────────────────────────────────────────────────────────────────────────
# Service coverage (admin-managed areas + ZIP codes)
# ─────────────────────────────────────────────────────────────────────────────
# Both default to true — you do NOT need to set either one to run the feature.
# They exist as rollback levers: flipping one is a restart, not a deploy.
#
# Reject a booking whose ZIP is not served (default: true). Set "false" to make
# the resolver still run and log its verdict but never reject — use this if
# coverage data turns out to be wrong in production and you need bookings to
# keep flowing while you fix it.
# REQUIRES the geography migrations to have run. With an empty Area table and
# this ON, every on-site booking is refused.
BOOKING_COVERAGE_ENFORCED=true
#
# When a customer's ZIP is not in the database at all, allow the booking against
# the area the client asked for instead of refusing (default: true). Keeps a
# newly-created market bookable in the window between creating it and loading its
# ZIP codes. Set "false" once every active area has at least one active ZIP.
COVERAGE_ZIP_FALLBACK=true
