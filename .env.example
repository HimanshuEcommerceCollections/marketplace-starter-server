# ──────────────────────────────────────────────────────────────
# Server environment. Copy to `.env` and fill in real values.
# `.env` is gitignored — never commit secrets.
# ──────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=4000

# Cloud Postgres connection string (Neon / Supabase / RDS).
# Hosted Postgres almost always requires SSL — keep `?sslmode=require`.
#   Neon:     postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/DB?sslmode=require
#   Supabase: postgresql://postgres:PASSWORD@db.xxx.supabase.co:5432/postgres
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# JWT — generate strong, unique secrets (min 16 chars; 48+ bytes recommended):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Security
BCRYPT_SALT_ROUNDS=10
CORS_ORIGIN="*"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Email (Resend) — used for account email-verification.
# RESEND_API_KEY is optional: without it the app still boots and email-dependent
# flows respond 501 (dev/test). Get a key at https://resend.com.
# EMAIL_FROM must be a Resend-verified sender in production. The default sender
# (onboarding@resend.dev) only delivers to the Resend account owner's address.
# APP_URL is the FRONTEND base URL used to build the verification link a user
# clicks — set it to your deployed frontend origin (https) in production.
RESEND_API_KEY=""
EMAIL_FROM="Elevate Health & Wellness <onboarding@resend.dev>"
APP_URL="http://localhost:3000"
# Verification-token lifetime in milliseconds (default 24h).
EMAIL_VERIFICATION_TTL_MS=86400000
# Master switch for the email-verification feature (default: true). Set to
# "false" to disable it entirely: new accounts are created active + verified, no
# verification email is sent, and login/booking are NOT gated. Useful while on
# Resend's sandbox sender (which only delivers to the account owner).
EMAIL_VERIFICATION_REQUIRED=true
